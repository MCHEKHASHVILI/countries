{
    "name": "mchekhashvili/countries",
    "description": "ISO 3166-1 countries for Laravel: an Eloquent model with Georgian, English and Russian names and each country's currency.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "countries", "iso3166", "eloquent", "georgian"],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "mchekhashvili/money": "^1.0@dev"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Mchekhashvili\\Countries\\": "src/",
            "Mchekhashvili\\Countries\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mchekhashvili\\Countries\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Mchekhashvili\\Countries\\CountriesServiceProvider"]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
